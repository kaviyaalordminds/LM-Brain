# ============================================================
# Memory Agent — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Obsidian Adapter ────────────────────────────────────────
# Options: mock | local | real
# Use 'local' to index and search the company Obsidian vault.
OBSIDIAN_ADAPTER=local

# Path to the company Obsidian vault (used when OBSIDIAN_ADAPTER=local or real)
OBSIDIAN_VAULT_PATH=C:\Lordminds\Multiagent\memory-agent\obsedian

# ── Research Provider ───────────────────────────────────────
# Options: mock | jina
# Use 'mock' during testing; 'jina' for live web & reader research.
RESEARCH_PROVIDER=mock

# API key for the external research provider (never hardcode this)
# RESEARCH_API_KEY=your_api_key_here

# Timeout in seconds for external research requests
RESEARCH_TIMEOUT_SECONDS=30

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
