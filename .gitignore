# =============================================================================
# Git Ignore Configuration
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/

# ── Testing & Code Quality ───────────────────────────────────────────────────
.pytest_cache/
.cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ── Logs & Debugging ─────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── IDE & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Operating System ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
__MACOSX/
._*
*/__MACOSX/*
*/._*

# ── Temporary Files ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak

